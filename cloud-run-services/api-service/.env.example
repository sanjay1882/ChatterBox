MONGO_URI=mongodb://localhost:27017/chatterbox
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GROQ_API_KEY=your_groq_key_here
FRONTEND_URL=http://localhost:5173
PORT=3000

# ── Razorpay (UPI / Indian payments) ──────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Stripe (International card payments) ──────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ANNUAL=price_xxxxxxxxxxxxxxxx
# From Stripe Dashboard > Webhooks (use 'stripe listen' locally)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
